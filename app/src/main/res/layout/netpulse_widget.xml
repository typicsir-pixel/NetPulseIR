<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#101A2D">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="NetPulse IR"
            android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="17sp"/>
        <TextView android:id="@+id/vpn" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="VPN: نامشخص"
            android:textColor="#FFD166" android:textSize="11sp"/>
    </LinearLayout>
    <TextView android:id="@+id/network" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="9dp"
        android:text="در انتظار شروع پایش" android:textColor="#E8F0FF" android:textSize="13sp"/>
    <TextView android:id="@+id/latency" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="5dp"
        android:text="Cloudflare: -- | تأخیر: --"
        android:textColor="#8FB6FF" android:textSize="12sp"/>
    <TextView android:id="@+id/updated" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:text="آخرین بررسی: --" android:textColor="#9AAAC3" android:textSize="10sp"/>
</LinearLayout>
